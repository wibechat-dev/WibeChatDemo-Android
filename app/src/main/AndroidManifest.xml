<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera, microphone, internet and screen capture come from the SDK manifest. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets an incoming call take over the screen, like a phone call. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".WibeChatApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WibeChat">

        <!-- Single activity. PiP: the call shrinks into a floating window when
             the user leaves the app mid-call (see MainActivity.onUserLeaveHint). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen ringing UI, shown over the lock screen. -->
        <activity
            android:name=".notifications.IncomingCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.WibeChat.Call"
            android:turnScreenOn="true" />

        <service
            android:name=".notifications.WibeChatMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Decline + ring timeout, handled without opening the app. -->
        <receiver
            android:name=".notifications.CallActionReceiver"
            android:exported="false" />

        <!-- Used by FCM for pushes that carry a `notification` block while the
             app is in the background (the server sends this channel id). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="high_importance_channel" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
    </application>
</manifest>
