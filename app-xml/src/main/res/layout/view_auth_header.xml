<?xml version="1.0" encoding="utf-8"?>
<!-- Logo row, big title and subtitle above the form card (Compose AuthLayout). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back to sign in"
            android:src="@drawable/ic_arrow_back"
            android:visibility="gone"
            app:tint="@color/text_primary" />

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/app_logo"
            app:shapeAppearance="@style/ShapeAppearance.WibeChat.Logo" />

        <TextView
            style="@style/Text.WibeChat.TitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/app_name" />
    </LinearLayout>

    <TextView
        android:id="@+id/title"
        style="@style/Text.WibeChat.HeadlineLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp" />

    <TextView
        android:id="@+id/subtitle"
        style="@style/Text.WibeChat.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />
</LinearLayout>
